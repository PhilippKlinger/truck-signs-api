# Copy this file to .env and replace every required blank value.
# Never commit .env or add real credentials, usernames, public IP addresses,
# or private infrastructure details to this example file.

# Django runtime
MODE=prod
DEBUG_ENABLED=False
LOG_LEVEL=ERROR
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend image
BACKEND_IMAGE=truck-signs-api:local
#BACKEND_IMAGE=ghcr.io/philippklinger/truck-signs-api:v1.0.1 -> VPS

# PostgreSQL
DB_NAME=trucksigns_db
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Django superuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
